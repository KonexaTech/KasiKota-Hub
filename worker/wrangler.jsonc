{
  "name": "kota-connect-api-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "NEON_ONLY_MODE": "true",
    "EXPECTED_NEON_HOST": "ep-lively-leaf-za5rtfhs.c-2.eu-west-2.aws.neon.tech",
    "NEON_AUTH_BASE_URL": "https://ep-lively-leaf-za5rtfhs.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth",
    "NEON_AUTH_JWKS_URL": "https://ep-lively-leaf-za5rtfhs.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json",
    "ALLOWED_ORIGIN": "https://siboniisozulu-alt.github.io",
    "ALLOWED_ORIGINS": "https://siboniisozulu-alt.github.io,https://kota-connect-neon-staging.pages.dev,https://kota-connect-api-dev.siboniisozulu.workers.dev,https://localhost,http://localhost",
    "DELIVERY_DISPATCH_ENABLED": "true",
    "DELIVERY_SOURCE_LOOKUP_ENABLED": "true",
    "DELIVERY_CALLBACKS_ENABLED": "true",
    "DELIVERY_SERVICE_URL": "https://konexa-delivery-private-staging.pages.dev",
    "KOTA_STAGING_DISPATCH_RECOVERY_ENABLED": "false",
    "KOTA_DELIVERY_ORDER_SYNC_ENABLED": "false"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
